{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    // "ignoreDeprecations": "6.0",
    "rootDir": ".",
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"],
}
